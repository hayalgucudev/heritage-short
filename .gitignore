.env
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Keep runs.jsonl, storyboard.json, outputs/manifest.json, and small keyframe/smoke PNGs tracked.
# Ignore bulky generated audio and video artifacts.
outputs/**/*.mp4
outputs/**/*.mov
outputs/**/*.mkv
outputs/**/*.webm
outputs/**/*.wav
outputs/**/*.mp3
outputs/**/*.aac
outputs/**/*.pcm
outputs/clips/
outputs/final/
# Ignore downloaded Kaggle zip bundles (director's choice, 2026-11-25).
# The approved ACE-Step WAV and the 10 narration WAVs are force-added so a clean clone needs no model calls.
*.zip
